Download_File() {
    # Parameter options: $1 = file name to download, $2 = full path + filename to download to
    # Download file from Github once to a temp location. If the same as the destination file, don't replace.
    # Otherwise move it from the temp location to the destination.
    if curl -fsNL --retry 3 --connect-timeout 10 --max-time 12 "${SCRIPT_REPO}/${1}" -o "/tmp/${1}"; then
        if [ "$(md5sum "/tmp/${1}" | awk '{print $1}')" != "$(md5sum "${2}" 2>/dev/null | awk '{print $1}')" ]; then
            mv -f "/tmp/${1}" "${2}"
            log_msg "Green" "   - Installing $(basename "${1}")"
        else
            #log_msg "Yellow" "  File $(basename "${2}") is already up-to-date" #v1.3.0 no longer displaying this msg
            rm -f "/tmp/${1}" 2>/dev/null
        fi
    else
        log_msg "Red" "   [ERROR] Download of $(basename "${1}") failed. Install aborted, check for Internet performance or DNS issues"
        exit 5
    fi
} # end of Download_File()

