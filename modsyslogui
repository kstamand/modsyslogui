Show_Logo(){
    local str_branch str_version left right upper_branch

    upper_branch=$(echo "$SCRIPT_BRANCH" | tr 'abcdefghijklmnopqrstuvwxyz' 'ABCDEFGHIJKLMNOPQRSTUVWXYZ')   # v1.4.0 - busybox tr has no [:lower:] classes
    # Define the color for the branch based on the repo status
   if [ "$SCRIPT_BRANCH" = "main" ]; then
        str_branch="${GREEN_TEXT}${upper_branch}${RESET}"
        str_version="${GREEN_TEXT}${SCRIPT_VERSION}${RESET}"
   else
        str_branch="${MAGENTA_TEXT}${upper_branch}${RESET}"
        str_version="${MAGENTA_TEXT}${SCRIPT_VERSION}${RESET}"
   fi
    left=$(printf "%b" "$str_branch")
    right=$(printf "%b" "$str_version")

    White "#----------------------------------------------------------------#"
    White "#   __  __           _ ____            _             _   _ ___   #"
    White "#  |  \/  | ___   __| / ___| _   _ ___| | ___   __ _| | | |_ _|  #"
    White "#  | |\/| |/ _ \ / _| \___ \| | | / __| |/ _ \ / _  | | | || |   #"
    White "#  | |  | | (_) | (_| |___) | |_| \__ \ | (_) | (_| | |_| || |   #"
    White "#  |_|  |_|\___/ \____|____/ \___ |___/_|\___/ \__  |\___/|___|  #"
    White "#                            |___/             |___/             #"

    # Print the line: Green border/text, then the dynamic branch color, then back to Green for the end border
    printf "${WHITE_TEXT}#      Branch: %-28s ${WHITE_TEXT}Version: %-27s ${WHITE_TEXT}  #\n" "$left" "$right"

    White "#----------------------------------------------------------------#"
    printf "\n"
}

