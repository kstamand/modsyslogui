Red() { printf -- '\033[1;31m%s\033[0m\n' "${1}"; }
Green() { printf -- '\033[1;32m%s\033[0m\n' "${1}"; }
Yellow() { printf -- '\033[1;33m%s\033[0m\n' "${1}"; }
Magenta() { printf -- '\033[1;35m%s\033[0m\n' "${1}"; }
Cyan() { printf -- '\033[1;36m%s\033[0m\n' "${1}"; }
White() { printf -- '\033[1m%s\033[0m\n' "${1}"; }

log_msg() {
    # $1 = display color; $2 = msg
    display_color="$1"
    msg="$2"
    if [ "$mode" = "interactive" ]; then
        if ! $AMTMUPDATE_RUN_FLAG; then   # v1.2.0 skip displaying progress info if called from amtm (amtmupdate)
            $display_color "$msg"
        fi
    else
        logger -t "$LOG_TAG" "$msg"
    fi
}

