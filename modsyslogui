Update() {
    # Parameter options
    # None - check for updates and present choice to force if no updates, then re-execute script after update and show menu
    # $1 = amtmupdate, running from amtm update, skip version check,minimize console output, then re-execute script then exit (postamtmupdate)
    # $1 = main or develop, executing a branch switch, skip version check, then re-execute script and show menu
    local switch_branch
    switch_branch=""
    [ "$1" = "main" ] && switch_branch="main"
    [ "$1" = "develop" ] && switch_branch="develop"

    # if called without any parameters, check if any updates available
    if [ ! "$1" = "amtmupdate" ]; then # if running via amtmupdate, skip version checking - already done
        # Check for, and optionally apply updates.
        # Parameter options: check (do not update), silent (update without prompting)
        local updatestatus yn remotever
        Scriptinfo
        log_msg "Green" "Checking for updates"
        # Update the webui status thorugh detect_update.js ajax call.
        # Get the version of the script on Github
        localver="$(grep "SCRIPT_VERSION=" "${SCRIPT_INSTALL_PATH}" | grep -m1 -oE "${scriptVersRegExp}")"
        remotever="$(curl -fsL --retry 4 --retry-delay 5 "${SCRIPT_REPO}/${SCRIPT_NAME}" | grep "SCRIPT_VERSION=" | grep -m1 -oE "${scriptVersRegExp}")"
        # Compare local and remote versions to see how to proceed
        if [ -z "${remotever}" ]; then
            # v1.4.0 - GitHub unreachable / bad response was previously reported as "Update available"
            updatestatus="Error"
        elif [ "${localver}" != "${remotever}" ]; then
            # version upgrade
            updatestatus="Update"
        else
            updatestatus="NoUpdate"
        fi

        case "${updatestatus}" in
        'NoUpdate')
            log_msg "Green" "   - You have the latest version installed"
            printf " Would you like to overwrite your existing installation anyway? [y=Yes n=No]: "
            ;;
        'Update')
            # New Version Number
            log_msg "Green" "   - ${SCRIPT_NAME_DISPLAY} ${updatestatus} is now available!"
            printf " Would you like to update now? [y=Yes n=No]: "
            ;;
        *)
            log_msg "Red" "   - Error occured checking version information (unable to reach GitHub?) - no changes made"
            return 1
            ;;
        esac
        read -r yn
        printf "\n"
        if [ "${yn}" = "n" ] || [ "${yn}" = "N" ]; then
            log_msg "Cyan" "   - No Changes have been made"
            return 0
        fi
    fi

    # v1.4.0 - download first (all or nothing); the page is only rebuilt after a successful download.
    #+ Mod_Syslog_Asp install rebuilds from a fresh stock page, so no separate uninstall is needed.
    if ! Download_Script_Files; then
        log_msg "Red" "   - Update aborted, existing installation left unchanged"
        return 1
    fi
    Mod_Syslog_Asp install     # Rebuild and mount the System Log UI page with the new files

    # if Update was called from amtmupdate, then re-execute the script then immediately run post ampduate logic check
    if $AMTMUPDATE_RUN_FLAG; then
        exec "$0" postamtmupdate    # rexecute the script, to run the logic flow check then exist immediately and return cleanly to amtm
    fi

    ##------------------------------------------------------------##
    ## v1.3.0 - added git hub repo switching (master and develop) ##
    ##------------------------------------------------------------##
    if [ "$switch_branch" = "main" ]; then
        log_msg "Green" "Completed switch to the stable (main) branch"
        Press_Enter
        exec "$0"
    elif [ "$switch_branch" = "develop" ]; then
        log_msg "Magenta" "Completed switch to the develop branch"
        Press_Enter
        exec "$0"
    fi

    # Output completion message
    log_msg "Green" "Completed installing updates"
    return 0
} # end of Update()

##---------------------------------##
## v1.2.0 amtmupdate functionality ##
##---------------------------------##
Update_FromAMTM() {
    # Parameters - none
    amtmupdate_state=$(Get_Amtmupdate_State)
    if ! "$amtmupdate_state"; then        #if not true, then amtmupdate state has been disabled
        log_msg "Yellow" "Automatic script updates via AMTM are currently disabled."
        return 1
    fi
    if [ $# -gt 0 ] && [ "$1" = "check" ]; then
        return 0
    fi
    log_msg "Cyan" "$SCRIPT_NAME_DISPLAY Running amtmupdate"
    AMTMUPDATE_RUN_FLAG=true     # set amtmupdate run flag to true, so we can minimize console output
    Update amtmupdate
    return "$?"
} # end Update_FromAMTM()

Edit () {
    # Parameters - none
    local before_hash
    local after_hash

    # Make sure the custom logFilter file exists, if not, copy it over (v1.4.0 - moved before hashing)
    if [ ! -f "${CUSTOM_LOGFILTER_PATH}" ]; then
        cp "${DEFAULT_LOGFILTER_PATH}" "${CUSTOM_LOGFILTER_PATH}"
    fi

    # Get the hash of the logFilter.json file BEFORE editing
    before_hash=$(sha256sum "${CUSTOM_LOGFILTER_PATH}" | awk '{ print $1 }')

    nano "${CUSTOM_LOGFILTER_PATH}"

    # Get the hash of the hidemenus list file AFTER editing
    after_hash=$(sha256sum "${CUSTOM_LOGFILTER_PATH}" | awk '{ print $1 }')

    # Check for any changes
    if [ ! "${before_hash}" = "${after_hash}" ]; then
        mount -o bind "${CUSTOM_LOGFILTER_PATH}" "${DEFAULT_LOGFILTER_PATH}"
        log_msg "Yellow" "Your changes have been saved to ${CUSTOM_LOGFILTER_PATH} and applied to the System"
    else
        log_msg "Yellow" "No changes were made to the ${CUSTOM_LOGFILTER_PATH}"
    fi
} # end of Edit()

