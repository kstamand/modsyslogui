##   /tmp/modsyslogui-dev (developer scratch, see deploy.sh).           ##
##   Anywhere else (e.g. /tmp/modsyslogui as a file, for a fresh        ##
##   install) defaults to production, unless MODSYSLOGUI_DIR is set to  ##
##   one of the allowed directories.                                    ##
##----------------------------------------------------------------------##
Resolve_Addon_Dir() {
    local self_dir want
    self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
    want="${MODSYSLOGUI_DIR:-$self_dir}"
    case "$want" in
        "${ADDON_DIR}/${SCRIPT_NAME}"|"${ADDON_DIR}/test/${SCRIPT_NAME}"|"/tmp/${SCRIPT_NAME}-dev") printf '%s' "$want" ;;
        *) printf '%s' "${ADDON_DIR}/${SCRIPT_NAME}" ;;
    esac
}
