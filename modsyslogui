log_msg() {
    # $1 = display color; $2 = msg
    display_color="$1"
    msg="$2"
    # v1.4.1 - console only for interactive, non-amtm runs; amtm runs (amtmupdate / postamtmupdate)
    #+ go to syslog so nothing is printed into amtm's screen
    if [ "$mode" = "interactive" ] && ! $AMTMUPDATE_RUN_FLAG; then
        $display_color "$msg"
    else
        # v1.4.0 - drop the console indentation / "- " bullet in syslog records
        logger -t "$LOG_TAG" "$(printf '%s' "$msg" | sed 's/^ *- *//; s/^ *//')"
    fi
}

