##-------------------------------------------------------------------------##
## v1.4.0 - page build safety checks                                       ##
##   Check_Stock_Asp:  the stock page contains every insertion anchor      ##
##   Verify_Syslog_Asp: the built page has each custom block, the filter   ##
##                      and ui blocks exactly once, and no stock handler   ##
##-------------------------------------------------------------------------##
Asp_Count() {
    # $1 = fixed string to count (lines containing it) in the custom asp file
    grep -cF "$1" "${CUSTOM_SYSLOG_ASP_FILE}" 2>/dev/null || true
}

Check_Stock_Asp() {
    local ok=0
    [ "$(grep -c '^<script>$' "${CUSTOM_SYSLOG_ASP_FILE}")" -ge 1 ] || { log_msg "Red" "   - missing anchor: <script>"; ok=1; }
    [ "$(Asp_Count 'var logString = htmlEnDeCode')" -eq 1 ] || { log_msg "Red" "   - missing/duplicate anchor: var logString = htmlEnDeCode"; ok=1; }
    [ "$(Asp_Count 'setTimeout(get_log_data, 3000);')" -ge 1 ] || { log_msg "Red" "   - missing anchor: setTimeout(get_log_data, 3000);"; ok=1; }
    [ "$(Asp_Count 'success: function(response){')" -eq 1 ] || { log_msg "Red" "   - missing/duplicate anchor: success: function(response){"; ok=1; }
    [ "$(Asp_Count 'onclick="applySettings();"')" -eq 1 ] || { log_msg "Red" "   - missing/duplicate anchor: applySettings button"; ok=1; }
    return "$ok"
}

Verify_Syslog_Asp() {
    local ok=0
    [ "$(Asp_Count '//++ Start modsyslogui custom function code')" -ge 1 ] || { log_msg "Red" "   - custom function block not inserted"; ok=1; }
    [ "$(Asp_Count '//++ Start modsyslogui custom filter code')" -eq 1 ] || { log_msg "Red" "   - custom filter block not inserted exactly once"; ok=1; }
    [ "$(Asp_Count '<!-- //++ Start modsyslogui custom xml -->')" -eq 1 ] || { log_msg "Red" "   - custom ui block not inserted exactly once"; ok=1; }
    [ "$(Asp_Count 'var logString = htmlEnDeCode')" -eq 0 ] || { log_msg "Red" "   - stock log handler was not removed"; ok=1; }
    return "$ok"
}

Mod_Syslog_Asp() {
    # Parameters: $1 install or uninstall; $2 (optional) quiet = no progress message (v1.4.0)
    case $1 in
        install)
            ##-------------------------------------------------------------------##
            ## v1.4.0 - always rebuild from a fresh copy of the stock page.      ##
            ## The old marker cleanup never matched, so a second enable doubled  ##
            ## the inserted code and stacked a second bind mount.                ##
            ##-------------------------------------------------------------------##
            Mod_Syslog_Asp uninstall quiet   # unmount (all) + remove any previous custom page, without logging
            log_msg "Green" "   - Copying Asus's default Syslog ASP page, for adding in custom filtering capabilities"
            cp "${DEFAULT_SYSLOG_ASP_FILE}" "${CUSTOM_SYSLOG_ASP_FILE}"
            # v1.4.0 - make sure the stock page still has the text this script edits around
            if ! Check_Stock_Asp; then
                log_msg "Red" "   [ERROR] Stock System Log page is not in the expected format (firmware change?) - filtering NOT enabled"
                rm -f "${CUSTOM_SYSLOG_ASP_FILE}"
                return 1
            fi
            log_msg "Green" "   - Adding filtering capabilities to System Log UI page"
            # insert custom filtering globals, vars, and helpers
            sed -i "/^<script>$/r ${CUSTOM_FUNCTION_FILE}" "${CUSTOM_SYSLOG_ASP_FILE}"
            # remove the default log record handling function
            sed -i '/var logString = htmlEnDeCode/,/setTimeout(get_log_data, 3000);/d' "${CUSTOM_SYSLOG_ASP_FILE}"
            sed -i "/success: function(response){/r ${CUSTOM_FILTER_FILE}" "${CUSTOM_SYSLOG_ASP_FILE}"

            # insert custom ui xml codeing
            sed -i "/onclick=\"applySettings();\"/r ${CUSTOM_UI_FILE}" "${CUSTOM_SYSLOG_ASP_FILE}" #v1.0.1 changed insertion point

            # v1.4.0 - never mount a broken page (e.g. a firmware update changed the stock page)
            if ! Verify_Syslog_Asp; then
                log_msg "Red" "   [ERROR] Customized System Log page failed validation - stock page left in place"
                rm -f "${CUSTOM_SYSLOG_ASP_FILE}"
                return 1
            fi
            # mount the customized web page with filtering capabilities added
            mount -o bind "${CUSTOM_SYSLOG_ASP_FILE}" "${DEFAULT_SYSLOG_ASP_FILE}"
        ;;
        uninstall)
            [ "$2" = "quiet" ] || log_msg "Green" "   - Removing filtering capabilities from System Log UI page"
            ##----------------------------------------------##
            ## v1.0.2 unmount customized System Log UI page ##
            ##----------------------------------------------##
            if grep -q " ${SYSLOGPAGE_MP} " /proc/mounts; then
                while grep -q " ${SYSLOGPAGE_MP} " /proc/mounts; do # unmount multiples, in case more than 1
                    umount "${SYSLOGPAGE_MP}" 2>/dev/null || break
                done
            fi
            rm "$CUSTOM_SYSLOG_ASP_FILE" 2>/dev/null
        ;;
    esac
} # end of Mod_Syslog_Asp()

