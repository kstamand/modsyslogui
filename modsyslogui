            "Cyan" "  (dm) Disable modsyslogui  disable dynamic UI filtering"
        else
            "Cyan" "  (em) Enable modsyslogui   enable dynamic UI filtering"
        fi
    else
        "Cyan" "  (em) Enable modsyslogui   enable dynamic UI filtering"
    fi
    if [ $(Get_Amtmupdate_State) = true ]; then
        "Cyan" "  (da) Disable Amtmupdate   disable amtmupdate auto updates"
    else 
        "Cyan" "  (ea) Enable Amtmupdate     enable amtmupdate auto updates"
    fi
    if [ "$SCRIPT_BRANCH" = "master" ]; then
        "Cyan" "  (sd) Switch develop           switch to development branch (BETA TESTERS ONLY)"
