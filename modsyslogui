Update() {    
    # Parameter options
    # None - check for updates and present choice to force if no updates, then re-execute script after update and show menu
    # $1 = amtmupdate, running from amtm update, skip version check,minimize console output, then re-execute script then exit (postamtmupdate)
    # $1 = master or develop, executing a branch switch, skip version check, then re-execute script and show menu
    local switch_branch
    switch_branch="" 
    [ "$1" = "master" ] && switch_branch="master"
    [ "$1" = "develop" ] && switch_branch="develop"
   
    # if called without any parameters, check if any updates available
    if [ ! "$1" = "amtmupdate" ]; then # if running via amtmupdate, skip version checking - already done
        # Check for, and optionally apply updates.
        # Parameter options: check (do not update), silent (update without prompting)
        local updatestatus yn remotever
        Scriptinfo
        log_msg "Green" "Checking for updates"
        # Update the webui status thorugh detect_update.js ajax call.
        # Get the version of the script on Github
        localver="$(grep "SCRIPT_VERSION=" ${SCRIPT_INSTALL_PATH} | grep -m1 -oE "${scriptVersRegExp}")"
        remotever="$(curl -fsL --retry 4 --retry-delay 5 "${SCRIPT_REPO}/${SCRIPT_NAME}" | grep "SCRIPT_VERSION=" | grep -m1 -oE "${scriptVersRegExp}")"
        # Compare local and remote versions to see how to proceed
        if [ "${localver}" != "${remotever}" ]; then
            # version upgrade
            updatestatus="Update"
        else
            updatestatus="NoUpdate"
        fi

        case "${updatestatus}" in
        'NoUpdate')
            log_msg "Green" "   - You have the latest version installed"
            printf " Would you like to overwrite your existing installation anyway? [y=Yes n=No]: "
            ;;
        'Update')
            # New Version Number
            log_msg "Green" "   - ${SCRIPT_NAME_DISPLAY} ${updatestatus} is now available!"
            printf " Would you like to update now? [y=Yes n=No]: "
            ;;
        *)
            log_msg "Red" "   - Error occured checking version information"
            Press_Enter
            return
            ;;
        esac
        read -r yn
        printf "\n"
        if [ "${yn}" = "n" ] || [ "${yn}" = "N" ]; then
            log_msg "Cyan" "   - No Changes have been made"
            return 0
        fi
    fi

	Mod_Syslog_Asp uninstall   # Disable - Remove filtering mod from System Log UI
    Download_Script_Files      # Download all associated files
    Mod_Syslog_Asp install     # Re-Enable - Add filtering mod back to System Lot UI

    # if Update was called from amtmupdate, then re-execute the script then immediately run post ampduate logic check
    if $AMTMUPDATE_RUN_FLAG; then 
        exec "$0" postamtmupdate    # rexecute the script, to run the logic flow check then exist immediately and return cleanly to amtm
    fi
    
    ##------------------------------------------------------------##
    ## v1.3.0 - added git hub repo switching (master and develop) ##
    ##------------------------------------------------------------##
    if [ "$switch_branch" = "master" ]; then
        log_msg "Green" "Completed switch to the stable (master) branch"
        Press_Enter
        exec "$0"
    elif [ "$switch_branch" = "develop" ]; then
        log_msg "Magenta" "Completed switch to the develop branch"
        Press_Enter
        exec "$0"
    fi

    # Output completion message
    log_msg "Green" "Completed installing updates"
    return 0
} # end of Update()

