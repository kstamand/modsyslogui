Download_Script_Files() {
    # Parameters: None
    # Returns: 0 = all files current, 5 = a download failed (NO files were changed)
    ##--------------------------------------------------------------------##
    ## v1.4.0 - developer testing: MODSYSLOGUI_NO_DOWNLOAD=1 keeps the     ##
    ## files already copied into the addon directory (see deploy.sh)      ##
    ##--------------------------------------------------------------------##
    if [ "${MODSYSLOGUI_NO_DOWNLOAD:-0}" = "1" ]; then
        log_msg "Yellow" "   - MODSYSLOGUI_NO_DOWNLOAD=1, using local files in ${SCRIPT_NAME_DIR}"
        return 0
    fi
    ##--------------------------------------------------------------------##
    ## v1.4.0 - download ALL files to a staging directory first; only     ##
    ## when every download succeeds are changed files moved into place,   ##
    ## so a failed download never leaves a half-updated install.          ##
    ## (presets.conf is user data and is never downloaded)                ##
    ##--------------------------------------------------------------------##
    local stage dst f
    stage="${TMP_DIR}/${SCRIPT_NAME}.staging"
    rm -rf "${stage}"
    mkdir -p "${stage}" "${SCRIPT_NAME_DIR}"

    set -- "${SCRIPT_INSTALL_PATH}" "${CUSTOM_FUNCTION_FILE}" "${CUSTOM_FILTER_FILE}" "${CUSTOM_UI_FILE}" "${PRESET_MANAGER}"
    for dst in "$@"; do
        f="$(basename "${dst}")"
        if ! curl -fsNL --retry 3 --connect-timeout 10 --max-time 12 "${SCRIPT_REPO}/${f}" -o "${stage}/${f}" || [ ! -s "${stage}/${f}" ]; then
            log_msg "Red" "   [ERROR] Download of ${f} failed - no files were changed. Check for Internet performance or DNS issues"
            rm -rf "${stage}"
            return 5
        fi
    done
    # sanity check: the main script must be a modsyslogui script (not an error page)
    if ! grep -q "^readonly SCRIPT_NAME=\"${SCRIPT_NAME}\"" "${stage}/${SCRIPT_NAME}"; then
        log_msg "Red" "   [ERROR] Downloaded ${SCRIPT_NAME} script is not valid - no files were changed"
        rm -rf "${stage}"
        return 5
    fi

    for dst in "$@"; do
        f="$(basename "${dst}")"
        if [ "$(md5sum "${stage}/${f}" | awk '{print $1}')" != "$(md5sum "${dst}" 2>/dev/null | awk '{print $1}')" ]; then
            mv -f "${stage}/${f}" "${dst}"
            log_msg "Green" "   - Installing ${f}"
        fi
    done
    rm -rf "${stage}"
    chmod 755 "${SCRIPT_INSTALL_PATH}" "${PRESET_MANAGER}" # make scripts executable
    return 0
} # end of Download_Script_Files()

Mod_Startup() {
    # Parameters: $1 - install or uninstall
    case $1 in
        'install')
            log_msg "Green" "   - Adding ${SCRIPT_NAME} services-start line"
            # check if a services-start file exists and process as follows
			if [ -f /jffs/scripts/services-start ]; then
                # delete any existing modsyslogui lines just in case (v1.4.0 - only lines tagged by this script)
                sed -i -e '/# added by '"${SCRIPT_NAME}"'/d' /jffs/scripts/services-start
                echo "${SCRIPT_AUTOSTART_CMD} # added by ${SCRIPT_NAME}" >> /jffs/scripts/services-start
			# a service-start file did not exist, so create one
            else
				echo "#!/bin/sh" > /jffs/scripts/services-start
                echo " " >> /jffs/scripts/services-start
                echo "${SCRIPT_AUTOSTART_CMD} # added by ${SCRIPT_NAME}" >> /jffs/scripts/services-start
				chmod 0755 /jffs/scripts/services-start
			fi
        ;;
        'uninstall')
			log_msg "Green" "   - Removing ${SCRIPT_NAME} from services-start"
            # remove only the lines tagged by this script (v1.4.0)
            [ -f /jffs/scripts/services-start ] && sed -i -e '/# added by '"${SCRIPT_NAME}"'/d' /jffs/scripts/services-start
        ;;
    esac
} # end of Mod_Start()

Auto_Startup() {
    # Paraemeters: None
    # Copy default System Log ASP file to scripts addon directory
    log_msg "Green" "   - Copying Asus's default Syslog ASP page, for adding in custom filtering capabilities"
